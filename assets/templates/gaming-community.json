  "categories": [
    {
      "name": "📌 START HERE",
      "read_only": true,
      "writers": [
        "Admin",
        "Moderator"
      ],
      "channels": [
        {
          "name": "👋┃welcome",
          "topic": "Start here.",
          "pin": true,
          "message": "**Welcome to {server}!** 🎮\n\nGrab a squad, share your best clips and join game night.\n\n1. Read {#rules}.\n2. Ask a mod for your platform role (**PC / Console / Mobile**) so LFG pings reach you.\n3. Find teammates in {#lfg} and jump into a 🔊 Squad channel.\n4. Drop your best plays in {#clips} - the best one each week gets featured.\n\nGame night is every week - times in {#announcements}."
        },
        {
          "name": "📜┃rules",
          "topic": "Play fair, be cool.",
          "pin": true,
          "message": "**Rules**\n\n1. **No toxicity.** Banter is fine; harassment, slurs and rage-baiting are not.\n2. **No cheats, hacks, exploits or account selling/boosting.**\n3. **Spoilers** for new games/updates only inside ||spoiler tags||.\n4. No spam, ads or random invites. Self-promo only in {#clips}.\n5. Use the right channel - LFG posts go in {#lfg}.\n6. Mods have the final say.\n\nWarning → timeout → ban."
        },
        {
          "name": "🎭┃get-roles",
          "topic": "Pick your platform and pings.",
          "pin": true,
          "message": "**Get your roles** - react below (remove the reaction to drop it):\n\n🖥️ {@PC}   🎮 {@Console}   📱 {@Mobile}\n🔴 {@Live Ping} - go-live alerts\n🎁 {@Giveaway Pings} - giveaways\n\nLevel roles ({@Rookie} → {@Legend}) come automatically as you chat.",
          "reactions": [
            "🖥️",
            "🎮",
            "📱",
            "🔴",
            "🎁"
          ]
        },
        {
          "name": "📢┃announcements",
          "type": "announcement",
          "topic": "Game nights, tournaments, new videos."
        },
        {
          "name": "🛠┃patch-notes",
          "topic": "Updates for the games we play."
        }
      ]
    },
    {
      "name": "🎮 GAMING",
      "channels": [
        {
          "name": "💬┃general",
          "topic": "Talk games and everything else."
        },
        {
          "name": "🔎┃lfg",
          "topic": "Looking for group: game, platform, rank, how many players.",
          "slowmode": 30,
          "pin": true,
          "message": "**LFG format**\nGame - Platform - Rank/Level - Players needed - Voice? (yes/no)\nExample: `Valorant - PC - Gold - need 2 - yes`"
        },
        {
          "name": "🎬┃clips",
          "topic": "Your best plays. Uploads unlock at Grinder (level 5) to stop spam bots. Clip of the week gets featured.",
          "slowmode": 60,
          "media_to": [
            "Grinder",
            "Pro",
            "Elite",
            "Legend",
            "Member+",
            "Moderator",
            "Admin"
          ]
        },
        {
          "name": "🆙┃level-ups",
          "read_only": true,
          "writers": [
            "Admin",
            "Moderator"
          ],
          "topic": "Level-up messages from the leveling bot. Add the bot's role to writers once it's invited."
        },
        {
          "name": "🖥┃setups",
          "topic": "Show your battlestation."
        },
        {
          "name": "💡┃suggestions",
          "type": "forum",
          "topic": "Ideas for the server, videos and events.",
          "message_title": "How to suggest",
          "message": "One idea per post. React 👍 to support ideas you like."
        },
        {
          "name": "😂┃memes",
          "topic": "Gaming memes only."
        },
        {
          "name": "👑┃legends-lounge",
          "private_to": [
            "Elite",
            "Legend",
            "Moderator",
            "Admin"
          ],
          "topic": "For Elite and Legend members. Keep grinding."
        }
